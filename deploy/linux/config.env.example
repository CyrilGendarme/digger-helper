# Digger Helper — Linux deployment settings.
# install.sh copies this to config.env (git-ignored). After editing config.env,
# apply it with:  digger-helper restart

# ── How the phone reaches the backend API ────────────────────────────────────
#   lan        http://<this machine's LAN IP>:BACKEND_PORT — phone must be on the same network
#   cloudflare free Cloudflare quick tunnel — works from anywhere, no account needed.
#              The URL changes whenever the tunnel restarts; the Expo service picks up
#              the new one automatically (re-open the app in Expo Go to reload it).
#   url        use API_PUBLIC_URL below (your own domain, reverse proxy, VPN address, …)
API_MODE=lan
API_PUBLIC_URL=

# ── How Expo Go reaches the app bundle ───────────────────────────────────────
#   tunnel     through Expo's relay (exp.direct) — works from anywhere, stable URL
#   lan        same network only
EXPO_HOST=tunnel

BACKEND_PORT=8000
EXPO_PORT=8081
