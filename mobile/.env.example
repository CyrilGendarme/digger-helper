# ── API ───────────────────────────────────────────────────────────────────────
# Usually leave EXPO_PUBLIC_API_URL unset: the app then sends its API calls to the
# Expo dev server it was loaded from (LAN or tunnel), which forwards /api/* to the
# backend (see metro.config.js). Set it only for a backend at another address,
# e.g. a production build: https://api.yourdomain.com/api/v1
# EXPO_PUBLIC_API_URL=

# Where the dev server's proxy finds the backend (default http://127.0.0.1:8000).
# DIGGER_BACKEND_URL=http://127.0.0.1:8000
